# Market data provider configuration
# ----------------------------------
# Choose a provider:
#   upstox   — live data via the Upstox v2 API (requires MARKET_ACCESS_TOKEN)
#   finnhub  — live data via the Finnhub REST API (requires FINNHUB_API_KEY)
#   mock     — deterministic synthetic data for local UI development
#              (the UI shows a clear "mock data" banner; do not ship to prod)
MARKET_PROVIDER=mock

# Upstox v2 API access token (issued by https://upstox.com/).
# Required when MARKET_PROVIDER=upstox. Do NOT prefix with VITE_ — it must
# never reach the browser bundle. Either of the two names below is accepted.
MARKET_ACCESS_TOKEN=
# UPSTOX_ACCESS_TOKEN=

# Finnhub API key (issued by https://finnhub.io/).
# Required when MARKET_PROVIDER=finnhub. Server-only — do NOT prefix with VITE_.
# A `VITE_FINNHUB_API_KEY` would be bundled into the browser and is unsafe.
# Coverage for Indian indices (NSE:NIFTY, BSE:SENSEX) depends on your plan;
# the dashboard degrades to a clear error if your plan doesn't include them.
FINNHUB_API_KEY=

# Optional. If set, the server will fetch this URL for FII/DII cash flows
# (used by both Upstox and Finnhub providers — Finnhub does not publish
# FII/DII directly).
# Expected JSON shape: { "fii": [{ "date": "2026-08-14", "value": 508.12 }], "dii": [...] }
# The values are in crores (positive = inflow, negative = outflow).
MARKET_FII_DII_URL=

# Poll interval (ms) used by the frontend for live quotes. Defaults to 15000.
# MARKET_REFRESH_INTERVAL_MS=15000
